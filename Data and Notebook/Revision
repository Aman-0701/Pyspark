### Reading csv file
df = spark.read.format('csv').option('inferSchema',True).option('header',True).load('path of file')

### Reading json file
df_json = spark.read.format('json').option('inferSchema',True).option('header',True).option('multiLine',False).load('path')

### Display data or show first few records
df.display()
df.limit(100)

### Schema Definition
df.printSchema()

### Importing all funtions and types
from pyspark.sql.functions import *
from pyspark.sql.types import *

### Selecting Col
df.select(col('a'),col('b')

### Alias or Renaming Column
df.select(col('a').alias('b'))
df.withColumnRenamed('old_name','new_name')

### Filter the data
df.filter( (col('a')==Aman) & (col('b') isin('Abc','bce')))

### Creating New column
df.withColumn('New',lit('new'))

### replacing exisitng column values
df.withColumn('col_a',regexp_replace('col_a','Aman','Aditya'))

### TypeCasting
df.withColumn('col_a',col('col_a').cast(StringType()))

### Sort Data
df.sort(col('col_a').asc())
df.sort(['col_a','col_b'],ascending=[0,0])

### Dropping columns
df.drop('col_1','col_2')

### Drop Duplicates
df.dropDuplicates()
df.dropDuplicates(subset=['col_1'])

### Preparing DataFrame
data1 = [('1','abc'),('2','bfg')]
schema1 = 'id STRING, name STRING'

df1 = spark.createDataFrame(data1,schema1)

data2 = [('3','adc'),('4','brg')]
schema1 = 'id STRING, name STRING'

### Union and Union All
df1.union(df2)
df1.unionByName(df2)

### InitiCap String function
df.select(inticap(col('A'))

### Date Function
df.withColumn('today_date',curr_date())
df.withColumn('next_week',dateadd('today_date',7))
df.withColumn('datediff',date_diff('next_week','today_date')
df.withColumn('next_week',date_format('next_week','dd/MMMM/yyyy'))

### Dropping nulls
df.dropna('all')
df.dropna('any')
df.dropna(subset=['A'])

### Split & Indexing
df.withColumn('A',split('A',' ')[1])

### Grouping
df.groupby('A','B').agg(sum('C').alias('sum'),avg('B').alias('average'))

### Pivot
df.groupby('A').pivot('B').agg(sum('C'))

### When Otherwise
df.withColumn('flag',when(col('A')=='veg','Vegetarian').otherwise('Non_veg')

### Joins
df1.join(df2,df1['dept_id']==df2['dept_id'],'inner')

### Window Functions
from pyspark.sql.window import Window

df.withColumn('row_number',row_number().over(Window.orderBy('A')))\
  .withColumn('dense_rank',dense_rank().over(Window.orderBy('A')))

df.withColumn('cum_sum',sum('A').over(Window.orderBy(col('B').desc().rowsBetween(Window.unbondedPreceding,Window.currentRow)))\
  .withColumn('cum_sum1',sum('A').over(Window.partitionBy('C').orderBy(col('B').desc().rowsBetween(Window.unboundedPreceding,Window.currentRow)))

### User Defined Fucntion
def my_func(x):
  return x*x

my_udf = udf(my_func)

df.withColumn('sc',my_udf('A'))

### Saving contents of dataframe to external storage
df.write.format('csv').save('location')
df.write.format('csv').mode('append').save('location')
df.write.format('csv').mode('overrwrite').save('location')
df.write.format('csv').mode('error').save('location')
df.write.format('csv').mode('ignore').save('location')

### Temp View - When we want to use spark, first we need to convert dataframe into b=object using temp_view
df.createTempView('my_view')
%sql
select * from my_view where col = 'A'
-- converting back to pyspark
df_sql =spark.sql("select * from my_view where col = 'A'")

